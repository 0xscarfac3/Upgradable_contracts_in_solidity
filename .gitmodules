[submodule "lib/openzeppelin-contracts-upgradeable"]
	path = lib/openzeppelin-contracts-upgradeable
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
[submodule "Upgradable_Contracts/lib/openzeppelin-contracts-upgradeable"]
	path = Upgradable_Contracts/lib/openzeppelin-contracts-upgradeable
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
[submodule "Upgradable_Contracts/lib/openzeppelin-contracts"]
	path = Upgradable_Contracts/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "Upgradable_Contracts/lib/foundry-devops"]
	path = Upgradable_Contracts/lib/foundry-devops
	url = https://github.com/chainaccelorg/foundry-devops
